# LOJAS FLASK - Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores reais

# ==================== SEGURANÇA ====================
# Chave secreta para sessões do Flask (gere uma string aleatória)
SECRET_KEY=seu-codigo-secreto-aqui

# Ambiente: development (testes) ou production (produção)
FLASK_ENV=development

# ==================== OPENROUTER API (IA) ====================
# Obtenha sua chave gratuita em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua-chave-api-aqui

# URL base da API (não altere a menos que saiba o que faz)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== CONFIGURAÇÕES DA IA ====================
# Modelo gratuito recomendado
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Temperatura (0 = mais preciso, 1 = mais criativo)
AI_TEMPERATURE=0.7

# Máximo de tokens por resposta
AI_MAX_TOKENS=500

# Ativar/desativar IA (true/false)
AI_ENABLED=true
EOF